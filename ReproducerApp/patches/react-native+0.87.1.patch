+ * file behaves exactly like stock 0.87.1, apart from the [mvcp] log lines.
+ *
+ * MVCPReproAnchorMode: 0 = stock 0.87.1 / main (first partially visible view)
+ *                      1 = prototype (first view whose origin is at or below the offset)
+ *                      2 = proposed (stock anchor, but if it straddles the leading edge and
+ *                          changes size, measure the first view that starts inside the viewport)
+ * MVCPReproGuardMode:  0 = stock 0.87.1 (tag check only behind enableViewCulling)
+ *                      1 = main, i.e. #57294 (nil, tag and superview checks)
+ *                      2 = proposed (main without the superview check)
+ */
+static NSInteger MVCPReproAnchorMode(void)
+{
+  return [[NSUserDefaults standardUserDefaults] integerForKey:@"MVCPReproAnchorMode"];
+}
+
+static NSInteger MVCPReproGuardMode(void)
+{
+  return [[NSUserDefaults standardUserDefaults] integerForKey:@"MVCPReproGuardMode"];
+}
+
+/*
+ * Lets the JS app show whether this patch was compiled in (it is not when React Native core comes
+ * from the prebuilt XCFrameworks): the app writes a random MVCPReproPing, and this echoes it back.
+ */
+static void MVCPReproEcho(void)
+{
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  NSString *ping = [defaults stringForKey:@"MVCPReproPing"];
+  if (ping != nil && ![ping isEqualToString:[defaults stringForKey:@"MVCPReproPong"]]) {
+    [defaults setObject:ping forKey:@"MVCPReproPong"];
+  }
+}
